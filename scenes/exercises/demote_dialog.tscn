[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/exercises/authoring/demote_dialog.gd" id="1"]

[node name="DemoteDialog" type="Window"]
title = "Demote a promoted exercise"
initial_position = 2
size = Vector2i(820, 580)
visible = false
transient = true
exclusive = true
min_size = Vector2i(600, 420)
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0745, 0.0941, 0.1216, 1)

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Intro" type="Label" parent="Margin/Column"]
layout_mode = 2
modulate = Color(0.66, 0.74, 0.82, 1)
text = "Removes a council-promoted exercise from the visualizer: its definition, muscle profile and media entry. Its source goes back to catalog-only, with the reason recorded. That revision can't be promoted again; a re-authored one can. Original exercises aren't listed."
autowrap_mode = 3

[node name="ExerciseList" type="ItemList" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="ReasonLabel" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "Reason (kept in the audit trail)"

[node name="ReasonInput" type="TextEdit" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
placeholder_text = "Why this exercise shouldn't be visualizable"
wrap_mode = 1

[node name="DemoteStatusLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 8

[node name="DemoteButton" type="Button" parent="Margin/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Demote selected"

[node name="DemoteCloseButton" type="Button" parent="Margin/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Close"
