[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/anatomy/anatomy_toolbar.gd" id="1_toolbar"]

[node name="AnatomyToolbar" type="PanelContainer"]
custom_minimum_size = Vector2(780, 94)
script = ExtResource("1_toolbar")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LayerRow" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BodyButton" type="Button" parent="Margin/Rows/LayerRow"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_pressed = true
text = "Body"
tooltip_text = "Show or hide the complete canonical body"

[node name="MuscleButton" type="Button" parent="Margin/Rows/LayerRow"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_pressed = true
text = "Muscles"
tooltip_text = "Show or hide skeletal muscles"

