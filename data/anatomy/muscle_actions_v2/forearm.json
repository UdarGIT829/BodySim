  "entries": [
    {
      "base_id": "muscle.abductor_pollicis_longus",
      "movement_muscle": true,
      "actions": [
        {
          "joint": "thumb_joints",
          "movement": "abduction",
          "weight": 0.9
        },
        {
          "joint": "thumb_joints",
          "movement": "extension",
          "weight": 0.3
        },
        {
          "joint": "wrist_joint",
          "movement": "radial_deviation",
          "weight": 0.3
        }
      ],
      "stabilizes": [],
      "confidence": "high",
      "rationale": "Abducts the thumb at the carpometacarpal joint, alongside abductor pollicis brevis, and assists carpometacarpal extension. Its tendon crosses the radial wrist, so it clearly assists radial deviation. It is a thumb abductor rather than a flexor, so it is not given grip, and its wrist role is too small for wrist_stability.",
      "status": "reviewed"
    },
    {
      "base_id": "muscle.anconeus",
      "movement_muscle": true,
      "actions": [
        {
          "joint": "elbow_joint",
          "movement": "extension",
          "weight": 0.2
        }
      ],
      "stabilizes": [
        {
          "demand": "elbow_stability",
          "weight": 0.3
        },
        {
          "demand": "elbow_joint_integrity",
          "weight": 0.3
        }
      ],
      "confidence": "medium",
      "rationale": "A small muscle that gives minor help to triceps in elbow extension. Its main role is tensing the posterior capsule and stabilizing the humeroulnar joint. The ulnar abduction it produces during pronation is not in the vocabulary.",
      "status": "reviewed"
    },
    {
      "base_id": "muscle.brachioradialis",
      "movement_muscle": true,
      "actions": [
        {
          "joint": "elbow_joint",
          "movement": "flexion",
          "weight": 0.7
        },
        {
          "joint": "radioulnar_joint",
          "movement": "supination",
          "weight": 0.2
        },
        {
          "joint": "radioulnar_joint",
          "movement": "pronation",
          "weight": 0.2
        }
      ],
      "stabilizes": [
        {
          "demand": "elbow_stability",
          "weight": 0.2
        }
      ],
      "confidence": "medium",
      "rationale": "A major elbow flexor, strongest with the forearm in neutral (hammer position). It rotates the forearm only back toward mid-position, from pronation or from supination, so both rotation weights are minor and position-dependent. It does not cross the wrist, so it has no grip or wrist_stability role.",
      "status": "reviewed"
    },
    {
      "base_id": "muscle.deep_head_of_pronator_teres",
      "movement_muscle": true,
      "actions": [
        {
          "joint": "radioulnar_joint",
          "movement": "pronation",
          "weight": 0.4
        }
      ],
      "stabilizes": [],
      "confidence": "medium",
      "rationale": "The small ulnar (coronoid) head pulls the radius into pronation. Because it arises distal to the humerus, it adds essentially no elbow flexion.",
      "status": "reviewed"
    },
    {
      "base_id": "muscle.extensor_carpi_radialis_brevis",
      "movement_muscle": true,
      "actions": [
        {
          "joint": "wrist_joint",
          "movement": "extension",
          "weight": 1.0
        },
        {
          "joint": "wrist_joint",
          "movement": "radial_deviation",
          "weight": 0.4
        }
      ],
      "stabilizes": [
        {
          "demand": "wrist_stability",
          "weight": 0.8
        }
      ],
      "confidence": "high",
      "rationale": "Its central insertion on the third metacarpal makes it the prime wrist extensor, especially during gripping. It is less radially placed than the longus, so radial deviation is a secondary action. It is the main extensor co-contracting to hold the wrist neutral against the flexion pull of a gripped load, hence a high wrist_stability weight.",
      "status": "reviewed"
    },
    {
      "base_id": "muscle.extensor_carpi_radialis_longus",
      "movement_muscle": true,
      "actions": [
        {
          "joint": "wrist_joint",
          "movement": "extension",
          "weight": 0.8
        },
        {
          "joint": "wrist_joint",
          "movement": "radial_deviation",
          "weight": 0.9
        },
        {
          "joint": "elbow_joint",
          "movement": "flexion",
          "weight": 0.1
        }
      ],
      "stabilizes": [
        {
          "demand": "wrist_stability",
          "weight": 0.6
        }
      ],
      "confidence": "high",
      "rationale": "It inserts on the second metacarpal, which makes it a major wrist extensor and a leading radial deviator. Its origin on the supracondylar ridge gives it only a minor elbow flexion moment. It co-contracts with ECRB to hold the wrist neutral under a hand load.",
      "status": "reviewed"
    },
    {
