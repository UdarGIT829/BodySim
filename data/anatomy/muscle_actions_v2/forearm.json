          "weight": 0.1
        }
      ],
      "stabilizes": [],
      "confidence": "high",
      "rationale": "It extends only the little finger, so its share of overall finger extension is small. It contributes only minor wrist extension, too little for a wrist_stability role.",
      "status": "reviewed"
    },
    {
