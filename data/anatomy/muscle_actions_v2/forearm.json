          "weight": 0.1
        }
      ],
      "stabilizes": [],
      "confidence": "high",
      "rationale": "It extends only the index finger, giving independent pointing, so its share of finger extension is small. It contributes only minor wrist extension.",
      "status": "reviewed"
    },
    {
