{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bodysim.kinematic_authoring_response.v3",
  "title": "BodySim kinematic authoring response v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "classification_reasons",
    "assumptions",
    "questions_requiring_context",
    "field_confidence",
    "proposed_definition"
  ],
  "properties": {
    "classification": {
      "type": "string",
      "enum": [
        "supported",
        "ambiguous",
        "unsupported"
      ]
    },
    "classification_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions_requiring_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "laterality",
        "input_mode",
        "kinetic_chain_type",
        "primary_joint_actions",
        "stabilization_demands"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "laterality": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "input_mode": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "kinetic_chain_type": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "primary_joint_actions": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "stabilization_demands": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "proposed_definition": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "variant",
            "aliases",
            "primary_movement_family",
            "additional_movement_families",
            "laterality",
            "input_mode",
            "kinematic_profile"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "primary_movement_family": {
              "type": "string",
              "enum": [
                "squat",
                "hip_hinge",
                "horizontal_push",
                "vertical_push",
                "horizontal_pull",
                "vertical_pull",
                "loaded_carry",
                "elbow_flexion",
                "elbow_extension",
                "knee_extension",
                "knee_flexion",
                "ankle_plantarflexion",
                "trunk_flexion",
                "lunge",
                "hip_bridge",
                "hip_flexion",
                "hip_abduction_adduction",
                "core_anti_extension",
                "core_rotation",
                "trunk_lateral_flexion",
                "shoulder_raise",
                "shoulder_rotation",
                "scapular_elevation",
                "wrist_and_grip",
                "olympic_lift",
                "jump_and_throw",
                "neck"
              ]
            },
            "additional_movement_families": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "squat",
                  "hip_hinge",
                  "horizontal_push",
                  "vertical_push",
                  "horizontal_pull",
                  "vertical_pull",
                  "loaded_carry",
                  "elbow_flexion",
                  "elbow_extension",
                  "knee_extension",
                  "knee_flexion",
                  "ankle_plantarflexion",
                  "trunk_flexion",
                  "lunge",
                  "hip_bridge",
                  "hip_flexion",
                  "hip_abduction_adduction",
                  "core_anti_extension",
                  "core_rotation",
                  "trunk_lateral_flexion",
                  "shoulder_raise",
                  "shoulder_rotation",
                  "scapular_elevation",
                  "wrist_and_grip",
                  "olympic_lift",
                  "jump_and_throw",
                  "neck"
                ]
              }
            },
            "laterality": {
              "type": "string",
              "enum": [
                "bilateral",
                "left",
                "right",
                "unilateral"
              ]
            },
            "input_mode": {
              "type": "string",
              "enum": [
                "repetitions",
                "duration"
              ]
            },
            "kinematic_profile": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kinetic_chain_type",
                "primary_joint_actions",
                "stabilization_demands",
                "one_sided_limbs"
              ],
              "properties": {
                "kinetic_chain_type": {
                  "type": "string",
                  "enum": [
                    "open_chain",
                    "closed_chain"
                  ]
                },
                "primary_joint_actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "joint",
                      "movement",
                      "emphasis",
                      "sides"
                    ],
                    "properties": {
                      "joint": {
                        "type": "string",
                        "enum": [
                          "ankle_joint",
                          "cervical_spine",
                          "elbow_joint",
                          "finger_joints",
                          "glenohumeral_joint",
                          "hip_joint",
                          "knee_joint",
                          "lumbar_spine",
                          "radioulnar_joint",
                          "scapulothoracic_joint",
                          "subtalar_joint",
                          "thumb_joints",
                          "toe_joints",
                          "wrist_joint"
                        ]
                      },
                      "movement": {
                        "type": "string",
                        "enum": [
                          "abduction",
                          "adduction",
                          "depression",
                          "dorsiflexion",
                          "downward_rotation",
                          "elevation",
                          "eversion",
                          "extension",
                          "external_rotation",
                          "flexion",
                          "horizontal_abduction",
                          "horizontal_adduction",
                          "internal_rotation",
                          "inversion",
                          "lateral_flexion",
                          "opposition",
                          "plantarflexion",
                          "pronation",
                          "protraction",
                          "radial_deviation",
                          "retraction",
                          "rotation",
                          "supination",
                          "ulnar_deviation",
                          "upward_rotation"
                        ]
                      },
                      "emphasis": {
                        "type": "string",
                        "enum": [
                          "primary",
                          "assist"
                        ]
                      },
                      "sides": {
                        "type": "string",
                        "enum": [
                          "working",
                          "both"
                        ]
                      }
                    }
                  }
                },
                "stabilization_demands": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "ankle_stability",
                      "anterior_shoulder_stability",
                      "anti_extension_hip",
                      "anti_extension_spine",
                      "anti_flexion_spine",
                      "anti_rotation_torso",
                      "elbow_joint_integrity",
                      "elbow_stability",
                      "femoral_head_stabilization",
                      "glenohumeral_stabilization",
                      "grip",
                      "humeral_head_stabilization",
                      "intra_abdominal_pressure",
                      "knee_joint_stability",
                      "lumbar_fascia_tension",
                      "patellar_tracking",
                      "pelvic_alignment",
                      "pelvic_leveling_frontal",
                      "postural_stabilization",
                      "postural_sway_control",
                      "scapular_anchoring",
                      "scapular_retraction_stability",
                      "scapular_stabilization",
                      "shoulder_position_hold",
                      "wrist_stability"
                    ]
                  }
                },
                "one_sided_limbs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "arm",
                      "leg"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
